# Slide-Wright — copy to .env and fill in. NEVER commit .env.
#
# Development runs free-of-charge by default: with no key set, the provider
# abstraction falls back to an offline stub and every deterministic layer
# (ingest, gate, apply, verify, audit, refresh, brand) runs unchanged.

# Google AI Studio / Gemini. Free tier is sufficient for development.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Only if evaluating an alternative provider.
ANTHROPIC_API_KEY=

# Optional. Overrides the vendored engine location.
SLIDE_WRIGHT_PPTMASTER=
