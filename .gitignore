# ── Private project intelligence — NEVER commit ──────────────────────────────
# Our persistent project brain: roadmap, research, strategy, decisions, costs.
# See private/README.md for what lives there and why it stays out of Git.
/private/

# ── Secrets ──────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json
secrets/

# Generated corpus fixtures. The generator is the source of truth
# (src/engine/slide_wright/corpus/synthesize.py), so the binaries are
# reproducible and do not belong in history.
/tests/corpus/*.pptx

# ── Customer material — decks are confidential by default ────────────────────
# Real customer/test decks must never enter history. Fixtures live in
# tests/corpus/ and are tracked only when explicitly cleared for sharing.
/inbox/
/outbox/
*.local.pptx
*.confidential.*

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/

# ── Node ─────────────────────────────────────────────────────────────────────
node_modules/
.next/
out/
coverage/
*.tsbuildinfo

# ── Working artifacts ────────────────────────────────────────────────────────
scratch/
tmp/
*.log
.DS_Store
Thumbs.db

# Vendored upstream engine. Large, not ours, and reproducible from
# scripts/vendor_engine.py plus vendor/pin.json.
/vendor/ppt-master/

# Third-party fixtures. Downloaded, never redistributed.
# Reproduce with: python scripts/fetch_fixtures.py
/tests/fixtures/third-party/
